  "raceRulesUpdatedTitle": "The race rules have been improved",
  "@raceRulesUpdatedTitle": {
    "description": "Shown once when a pre-gait save is detected"
  },
  "raceRulesUpdatedBody": "The rules have changed: you now draw a card, and its value gives both the distance and the difficulty. Your progress, badges and purchases are kept — only the game in progress cannot resume under the new rules.",
  "@raceRulesUpdatedBody": {
    "description": "Legacy save notice body"
  },
  "startNewRace": "Start a new race",
  "@startNewRace": {
    "description": "Button to start fresh after the rules change"
