  "raceRulesUpdatedTitle": "The race rules have been improved",
  "@raceRulesUpdatedTitle": {
    "description": "Shown once when a pre-gait save is detected"
  },
  "raceRulesUpdatedBody": "The rules have changed: you now draw a card, and its value gives both the distance and the difficulty. Your progress, badges and purchases are kept — only the game in progress cannot resume under the new rules.",
  "@raceRulesUpdatedBody": {
    "description": "Legacy save notice body"
  },
  "startNewRace": "Start a new race",
  "@startNewRace": {
    "description": "Button to start fresh after the rules change"
  },
  "rulesTitle": "The rules",
  "@rulesTitle": {
    "description": "Title of the rules screen"
  },
  "ruleGoalTitle": "Winning the race",
  "@ruleGoalTitle": {
    "description": "Rules step 1 title: how the race is won"
  },
  "ruleGoalBody": "Each player rides four horses towards Mecca, at the centre of the board. Before the game, the table chooses how many must get there: one for a quick race, two for a duo race, all four for the classic game. The first player to manage it wins.",
  "@ruleGoalBody": {
    "description": "Rules step 1 body: bring 1, 2 or 4 horses to Mecca"
  },
  "ruleKnowledgeTitle": "Knowledge points",
  "@ruleKnowledgeTitle": {
    "description": "Rules step title: the knowledge points"
  },
  "ruleKnowledgeBody": "The sparkle in the bar counts your knowledge points: one for every right answer, and one more on a Knowledge square. They do not move your horse — they say what you have learnt, and they separate the players if the game stops before anyone arrives.",
  "@ruleKnowledgeBody": {
    "description": "Rules step body: what the sparkle counter counts"
  },
  "ruleSpecialCellsTitle": "The special squares",
  "@ruleSpecialCellsTitle": {
    "description": "Rules step title: the special squares"
  },
  "ruleSpecialCellsBody": "The circuit you chose carries squares that do something, the same ones in each of its four quarters: the Oasis shields from capture, Knowledge gives a knowledge point, the Challenge offers a harder question for +2 gallops, the Shortcut a hard question to cut ahead, and Wisdom gives a fact to keep. A failed Challenge or Shortcut costs only the bonus: your horse stays where it is.",
  "@ruleSpecialCellsBody": {
    "description": "Rules step body: oasis, knowledge, challenge, shortcut, wisdom"
  },
  "ruleDrawCardTitle": "Draw a card",
  "@ruleDrawCardTitle": {
    "description": "Rules step 1 title"
  },
  "ruleDrawCardBody": "On your turn, draw a card. It turns over onto its stake — \"A 5-gallop card\" — and then its question opens, always at your own level, chosen before the game: easy, intermediate, expert or mixed. So you know what a right answer is worth before you answer.",
  "@ruleDrawCardBody": {
    "description": "Rules step: the card turns over onto its stake"
  },
  "ruleAnswerToAdvanceTitle": "Answer to advance",
  "@ruleAnswerToAdvanceTitle": {
    "description": "Rules step 2 title"
  },
  "ruleAnswerToAdvanceBody": "A right answer wins you the card's gallops: one gallop, one square. Then choose the horse that takes them — touch it to see where it would land, then drag it onto its gold square. The drop is the move: nothing moves before it, nothing asks to confirm after it. A wrong answer moves nothing at all: you never go backwards.",
  "@ruleAnswerToAdvanceBody": {
    "description": "Rules step: a right answer wins the card's gallops"
  },
  "ruleEscalierTitle": "The escalier to Mecca",
  "@ruleEscalierTitle": {
    "description": "Rules step 3 title"
  },
  "ruleEscalierBody": "After a full lap of the board, your horse climbs the five steps of its escalier to Mecca. Once there, no one can catch it.",
  "@ruleEscalierBody": {
    "description": "Rules step 3 body"
  },
  "ruleExitTitle": "Leaving the stable",
  "@ruleExitTitle": {
    "description": "Rules step: leaving the stable on a 6"
  },
  "ruleExitBody": "Each player has four horses, and the first already stands on its start square: you play from the very first card, with nothing to wait for. The other three leave the stable on a 6 — answer right and the horse takes the start square. Two of your horses can never share a square: one of yours sitting on your start square keeps the gate shut until it moves on.",
  "@ruleExitBody": {
    "description": "Rules step: the first horse is already out, the others need a 6"
  },
  "ruleSixTitle": "A 6 plays again",
  "@ruleSixTitle": {
    "description": "Rules step: a 6 grants another draw"
  },
  "ruleSixBody": "Just as on the die: draw a 6 and you play again after your turn, whether your answer was right or wrong.",
  "@ruleSixBody": {
    "description": "Rules step: a 6 replays, exactly as on the die"
  },
  "ruleCaptureTitle": "Capture and send home",
  "@ruleCaptureTitle": {
    "description": "Rules step 4 title"
  },
  "ruleCaptureBody": "Landing exactly on an opponent's horse sends it calmly back to its stable — unless the square is an oasis, or that horse carries a knowledge shield. A capture pays: your horse bounds 20 gallops forward at once. A horse leaving its stable always captures on its start square.",
  "@ruleCaptureBody": {
    "description": "Rules step 4 body: a capture sends the horse home and pays twenty"
  },
  "ruleStreakTitle": "The streak of right answers",
  "@ruleStreakTitle": {
    "description": "Rules step 5 title"
  },
  "ruleStreakBody": "Three correct answers in a row earn a shield, five the Grand Gallop, and ten a mastery badge. The Grand Gallop spends itself, and only when its +2 gallops are enough to reach the finish. Bonuses come from knowledge alone.",
  "@ruleStreakBody": {
    "description": "Rules step 5 body"
  },
  "ruleArrivalTitle": "The arrival",
  "@ruleArrivalTitle": {
    "description": "Rules step 6 title"
  },
  "ruleArrivalBody": "The finish is reached on an exact count: three squares from Mecca you need exactly a 3. A 4, a 5 or a 6 leaves the horse where it stands, waiting for the right card. Once there, answer the Question of the Journey to make the arrival official; a wrong answer never pushes you back, you simply try again next turn.",
  "@ruleArrivalBody": {
    "description": "Rules step 6 body: the finish is reached on an exact count"
  },
