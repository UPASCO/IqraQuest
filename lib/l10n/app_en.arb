  "rulesTitle": "The rules",
  "@rulesTitle": {
    "description": "Title of the rules screen"
  },
  "ruleDrawCardTitle": "Draw a card",
  "@ruleDrawCardTitle": {
    "description": "Rules step 1 title"
  },
  "ruleDrawCardBody": "On your turn, draw a card: its question opens at once, always at your own level — easy, intermediate or expert — chosen at the start. Its value, 1 to 6 squares, stays hidden until you answer.",
  "@ruleDrawCardBody": {
    "description": "Rules step 1 body"
  },
  "ruleAnswerToAdvanceTitle": "Answer to advance",
  "@ruleAnswerToAdvanceTitle": {
    "description": "Rules step 2 title"
  },
  "ruleAnswerToAdvanceBody": "A right answer wins you the card's squares. Then choose the horse that takes them: touch it to see where it would land, and drag it there — the drop is the move. A wrong answer leaves everything where it stands: you never go backwards.",
  "@ruleAnswerToAdvanceBody": {
    "description": "Rules step 2 body"
  },
  "ruleEscalierTitle": "The escalier to Mecca",
  "@ruleEscalierTitle": {
    "description": "Rules step 3 title"
  },
  "ruleEscalierBody": "After a full lap of the board, your horse climbs the five steps of its escalier to Mecca. Once there, no one can catch it.",
  "@ruleEscalierBody": {
    "description": "Rules step 3 body"
  },
  "ruleExitTitle": "Leaving the stable",
  "@ruleExitTitle": {
    "description": "Rules step: leaving the stable on a 6"
  },
  "ruleExitBody": "Each player has four horses, and the first is already on its start square: you play from the very first card, with nothing to wait for. The other three leave the stable on a 6: answer correctly and the horse takes the start square — and since a 6 plays again, it rides right away. The choice is yours: bring another out, or ride.",
  "@ruleExitBody": {
    "description": "Rules step body: one horse already out, the other three on a 6"
  },
  "ruleSixTitle": "A 6 plays again",
  "@ruleSixTitle": {
    "description": "Rules step: a 6 grants another draw"
  },
  "ruleSixBody": "Just like the die: when you draw a 6 you play again after your turn, whether your answer was right or not. And two of your own horses can never share a square.",
  "@ruleSixBody": {
    "description": "Rules step body: replay on 6, no two own horses on one square"
  },
  "ruleCaptureTitle": "Capture and send home",
  "@ruleCaptureTitle": {
    "description": "Rules step 4 title"
  },
  "ruleCaptureBody": "Landing exactly on an opponent's horse sends it calmly back to its stable — unless the square is an oasis, or that horse carries a knowledge shield. A horse leaving its stable always captures on its start square.",
  "@ruleCaptureBody": {
    "description": "Rules step 4 body"
  },
  "ruleStreakTitle": "The knowledge streak",
  "@ruleStreakTitle": {
    "description": "Rules step 5 title"
  },
  "ruleStreakBody": "Three correct answers in a row earn a shield, five the Grand Gallop, and ten a mastery badge. The Grand Gallop spends itself, and only when its +2 squares are enough to reach the finish. Bonuses come from knowledge alone.",
  "@ruleStreakBody": {
    "description": "Rules step 5 body"
  },
  "ruleArrivalTitle": "The arrival",
  "@ruleArrivalTitle": {
    "description": "Rules step 6 title"
  },
  "ruleArrivalBody": "Reach the end of the course — going past the line is fine — then answer the Question of the Journey to make your arrival official. A wrong answer never pushes you back: you simply try again next turn.",
  "@ruleArrivalBody": {
    "description": "Rules step 6 body"
  },
