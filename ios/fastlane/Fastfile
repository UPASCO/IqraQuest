default_platform(:ios)

# See store/apple/TESTFLIGHT_SETUP.md for the full list of GitHub Actions
# secrets this lane expects (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT,
# APPLE_TEAM_ID) and how to obtain each one.
require "base64"

platform :ios do
  # A missing secret must read as "add this secret", never as a Ruby
  # KeyError stack trace (the CI checks them too, but this lane can also
  # be run from a laptop).
  def required_env(name)
    value = ENV[name].to_s
    if value.empty?
      UI.user_error!(
        "The #{name} secret/environment variable is not set. " \
        "Add it (GitHub: Settings → Secrets and variables → Actions); " \
        "see store/apple/TESTFLIGHT_SETUP.md for how to obtain it.",
      )
    end
    value
  end

  # The .p8 content survives many paste accidents: quotes around it,
  # literal \n sequences, newlines collapsed to spaces, or the whole file
  # pasted as base64. Re-canonicalize instead of failing with OpenSSL's
  # cryptic "invalid curve name".
  def normalized_asc_key
    raw = required_env("ASC_KEY_CONTENT").strip
    raw = raw.delete_prefix('"').delete_suffix('"').delete_prefix("'").delete_suffix("'")
    raw = raw.gsub('\n', "\n")

    unless raw.include?("BEGIN PRIVATE KEY")
      begin
        decoded = Base64.strict_decode64(raw.gsub(/\s+/, ""))
        raw = decoded if decoded.include?("BEGIN PRIVATE KEY")
      rescue ArgumentError
        # fall through to the explicit error below
      end
    end

    body = raw[/-----BEGIN PRIVATE KEY-----(.*?)-----END PRIVATE KEY-----/m, 1]
    if body.nil? || body.gsub(/\s+/, "").empty?
      UI.user_error!(
        "ASC_KEY_CONTENT does not look like an App Store Connect .p8 key. " \
        "Open the downloaded AuthKey_XXXXXXXXXX.p8 file in a plain-text " \
        "editor and paste its ENTIRE content into the GitHub secret, " \
        "including the -----BEGIN PRIVATE KEY----- and " \
        "-----END PRIVATE KEY----- lines.",
      )
    end
    clean = body.gsub(/\s+/, "")
    "-----BEGIN PRIVATE KEY-----\n#{clean.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"
  end

  desc "Build the Flutter release IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: required_env("ASC_KEY_ID"),
      issuer_id: required_env("ASC_ISSUER_ID"),
      # Store the contents of the downloaded .p8 file as the
      # ASC_KEY_CONTENT secret (plain text preferred; base64 and common
      # paste mishaps are repaired by normalized_asc_key).
      key_content: normalized_asc_key,
      is_key_content_base64: false,
      in_house: false,
    )

    # Xcode manages signing automatically using the API key above — no
    # manually exported certificates/provisioning profiles to maintain.
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Runner.xcodeproj",
      team_id: required_env("APPLE_TEAM_ID"),
    )

    # NOTE: the build number is NOT set here. Flutter's Info.plist uses
    # $(FLUTTER_BUILD_NUMBER) directly (from Generated.xcconfig, itself
    # derived from `flutter build ios --build-number=N` or pubspec.yaml's
    # version), not $(CURRENT_PROJECT_VERSION) — so fastlane's usual
    # increment_build_number action has no effect on a Flutter app's
    # actual CFBundleVersion. The CI workflow instead passes
    # --build-number=${{ github.run_number }} to `flutter build ios`
    # before this lane runs — see .github/workflows/ios-testflight.yml.

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end
